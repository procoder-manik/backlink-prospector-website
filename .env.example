# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=backlink_prospector

# Only if you see "querySrv ECONNREFUSED" when connecting: look up Atlas through public DNS.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Password for the /admin orders dashboard. Use something long.
ADMIN_PASSWORD=change-me-to-a-long-password

# Signs customer login sessions for My account. Any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string
